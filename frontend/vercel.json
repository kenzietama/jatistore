{
  "rewrites": [
    {
      "source": "/swagger-ui.html",
      "destination": "https://jatistore-production.up.railway.app/swagger-ui/index.html"
    },
    {
      "source": "/swagger-ui/:path*",
      "destination": "https://jatistore-production.up.railway.app/swagger-ui/:path*"
    },
    {
      "source": "/v3/api-docs/:path*",
      "destination": "https://jatistore-production.up.railway.app/v3/api-docs/:path*"
    },
    {
      "source": "/v3/api-docs",
      "destination": "https://jatistore-production.up.railway.app/v3/api-docs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
